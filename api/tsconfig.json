{
	"compilerOptions": {
		"target": "ES2020",
		"incremental": false,
		"module": "commonjs",
		"outDir": "./dist",
		"baseUrl": "./src",
		"rootDir": "./src",
		"moduleResolution":"Node",

		"sourceMap": false,
		"declaration": false,
		"removeComments": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": false,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noEmit": false,

		/* Type Checking */
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strictBindCallApply": true,
		"strictPropertyInitialization": true,
		"alwaysStrict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,    

		/* Completeness */
		"skipDefaultLibCheck": true,
		"skipLibCheck": true,
		"types": ["node", "reflect-metadata", "jest"],
		"lib": ["ES2020"],
	},
	"include": [
		"./src"
	],
	"exclude": [
		"node_modules"
	],
	"ts-node": {
		"swc": true,
		//"transpileOnly": true,
		//"files": true,
	},
}
